// Kuromi fastfetch ♥  — logo em ~/dotfiles/themes/current/logo.png
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/dotfiles/themes/current/logo.png",
    "width": 30,
    "height": 15,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "38;2;255;143;200", "title": "38;2;183;148;246" },
    "key": { "width": 12 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;183;148;246m╭──────────── ♥ kuromi ♥ ─────────────╮" },
    { "type": "os",       "key": "  os" },
    { "type": "kernel",   "key": "  kernel" },
    { "type": "wm",       "key": "  wm" },
    { "type": "shell",    "key": "  shell" },
    { "type": "terminal", "key": "  term" },
    { "type": "packages", "key": "󰏖  pkgs" },
    { "type": "uptime",   "key": "󰅐  uptime" },
    { "type": "custom", "format": "\u001b[38;2;183;148;246m├─────────────────────────────────────┤" },
    { "type": "cpu",      "key": "  cpu", "showPeCoreCount": true },
    { "type": "gpu",      "key": "󰢮  gpu" },
    { "type": "memory",   "key": "  ram" },
    { "type": "disk",     "key": "󰋊  disk", "folders": "/" },
    { "type": "custom", "format": "\u001b[38;2;183;148;246m╰─────────────────────────────────────╯" },
    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
  ]
}
