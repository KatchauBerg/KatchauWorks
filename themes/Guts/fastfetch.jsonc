// Guts fastfetch ⚔ — logo: Marca do Sacrifício (themes/Guts/logo.png)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/dotfiles/themes/current/logo.png",
    "width": 28,
    "height": 14,
    "padding": { "top": 1, "left": 2, "right": 4 }
  },
  "display": {
    "separator": " ▸ ",
    "color": { "keys": "38;2;200;16;46", "title": "38;2;142;145;150" },
    "key": { "width": 11 }
  },
  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "custom", "format": "\u001b[38;2;74;70;70m━━━━━━━━━━━━━━━ \u001b[38;2;200;16;46m⚔ STRUGGLER ⚔\u001b[38;2;74;70;70m ━━━━━━━━━━━━━━━" },
    { "type": "os",       "key": "  OS" },
    { "type": "kernel",   "key": "  KERNEL" },
    { "type": "wm",       "key": "  WM" },
    { "type": "shell",    "key": "  SHELL" },
    { "type": "terminal", "key": "  TERM" },
    { "type": "packages", "key": "󰏖  PKGS" },
    { "type": "uptime",   "key": "󰅐  UPTIME" },
    { "type": "custom", "format": "\u001b[38;2;74;70;70m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" },
    { "type": "cpu",      "key": "  CPU", "showPeCoreCount": true },
    { "type": "gpu",      "key": "󰢮  GPU" },
    { "type": "memory",   "key": "  RAM" },
    { "type": "disk",     "key": "󰋊  DISK", "folders": "/" },
    { "type": "custom", "format": "\u001b[38;2;74;70;70m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 2 }
  ]
}
